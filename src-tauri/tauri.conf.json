{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleetify",
  "version": "0.1.0",
  "identifier": "com.fleetify.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run build:sidecars && npm run dev",
    "beforeBuildCommand": "npm run build:sidecars:release && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "macos-fps": {
      "enabled": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0QzY5NDcxM0EyMEQ3NTEKUldSUjF5QTZjWlRHUkxYS3dMTUVIK00yM0pVWEpUMDhMYmF6SUFCRHEvcklrNVBha0ZhcWRsb00K",
      "endpoints": [
        "https://fleetify.dev/api/desktop/update/{{target}}/{{arch}}/{{current_version}}?bundle_type={{bundle_type}}",
        "https://github.com/fleetifydev/fleetify/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "externalBin": [
      "binaries/fleet-memory-mcp",
      "binaries/fleet-dispatch-mcp",
      "binaries/fleet-reveng-mcp",
      "binaries/fleet-browser-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Fleetify",
    "copyright": "Copyright © 2026 The Fleetify Authors",
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "Local agent fleet for Claude, Codex, Gemini.",
    "longDescription": "Fleetify is a desktop control plane for Claude, Codex, and Gemini agent sessions — Fleet, the in-app orchestrator, dispatches work to many agents on real projects in parallel, watches progress live, and ships PRs through the same workflow you already use on the command line.",
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  }
}
