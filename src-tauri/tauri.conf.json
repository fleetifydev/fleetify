{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleetify",
  "version": "0.2.1",
  "identifier": "com.fleetify.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run build:sidecars && npm run dev",
    "beforeBuildCommand": "npm run build:sidecars:release && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "macos-fps": {
      "enabled": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0QzY5NDcxM0EyMEQ3NTEKUldSUjF5QTZjWlRHUkxYS3dMTUVIK00yM0pVWEpUMDhMYmF6SUFCRHEvcklrNVBha0ZhcWRsb00K",
      "endpoints": [
        "https://fleetify.dev/api/desktop/update/{{target}}/{{arch}}/{{current_version}}?bundle_type={{bundle_type}}",
        "https://github.com/fleetifydev/fleetify/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "externalBin": [
      "binaries/fleet-memory-mcp",
      "binaries/fleet-dispatch-mcp",
      "binaries/fleet-reveng-mcp",
      "binaries/fleet-browser-mcp"
    ],
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../NOTICE": "legal/NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Fleetify",
    "copyright": "Copyright © 2026 The Fleetify Authors",
    "license": "Apache-2.0",
    "category": "DeveloperTool",
    "shortDescription": "A command center for AI agents.",
    "longDescription": "Run Claude Code, Codex, OpenCode and other AI coding agents side by side from one desktop app. Give each session its own git worktree, follow every session's status and spend in the Fleet hub, and open pull requests without leaving Fleetify.",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "linux": {
      "deb": {
        "section": "devel",
        "depends": [
          "libwebkit2gtk-4.1-0 (>= 2.40)"
        ]
      }
    }
  }
}
