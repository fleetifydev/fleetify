/target
**/target
node_modules
dist
# TypeScript's incremental build state: `tsc -b` rewrites it on every type-check.
*.tsbuildinfo

# Single lockfile policy: the project standardizes on npm (package-lock.json).
# A stray pnpm-lock.yaml only invites dual-lockfile drift.
pnpm-lock.yaml
.DS_Store
*.log
fleet.db
fleet.db-wal
fleet.db-shm
*.premerge-bak
src-tauri/gen
# tauri-build rewrites these on every build, from src-tauri/src/app_commands.rs.
src-tauri/permissions/autogenerated
src-tauri/binaries
# Generated by the release build in CI and bundled from there; never committed.
/THIRD-PARTY-NOTICES
.env
.env.*
!.env.example

docs/superpowers/
.playwright-mcp/
.claude/
.firecrawl/

# Fleetify
.fleetify-worktrees/

# Local scratch — session notes, not shipped
notion.md
