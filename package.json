{
  "name": "fleetify",
  "private": true,
  "version": "0.2.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run --config vitest.renderer.config.ts",
    "tauri": "tauri",
    "wipe": "node scripts/wipe.mjs",
    "build:sidecars": "node scripts/build-sidecars.mjs",
    "build:sidecars:release": "node scripts/build-sidecars.mjs --release",
    "icons": "node scripts/icons.mjs",
    "dev:tauri": "cross-env FLEETIFY_ISSUER=http://localhost:3001 FLEETIFY_DASHBOARD_URL=http://localhost:3000 FLEETIFY_RESOURCE=http://127.0.0.1:8765 FLEETIFY_AUDIENCE=http://127.0.0.1:8765 tauri dev",
    "dev:tauri:wt": "node scripts/dev-tauri-wt.mjs",
    "dev:noauth": "cross-env FLEETIFY_NOAUTH=1 FLEETIFY_ISSUER=http://localhost:3001 FLEETIFY_DASHBOARD_URL=http://localhost:3000 FLEETIFY_RESOURCE=http://127.0.0.1:8765 FLEETIFY_AUDIENCE=http://127.0.0.1:8765 tauri dev",
    "prod": "cross-env WEBVIEW2_ADDITIONAL_BROWSER_ARGUMENTS=--remote-debugging-port=9222 FLEETIFY_ISSUER=https://fleetify.dev FLEETIFY_DASHBOARD_URL=https://app.fleetify.dev FLEETIFY_RESOURCE=https://fleetify.dev/api FLEETIFY_AUDIENCE=https://fleetify.dev/api tauri dev",
    "prod:build": "cross-env FLEETIFY_ISSUER=https://fleetify.dev FLEETIFY_DASHBOARD_URL=https://app.fleetify.dev FLEETIFY_RESOURCE=https://fleetify.dev/api FLEETIFY_AUDIENCE=https://fleetify.dev/api tauri build",
    "check:sidecars": "node scripts/build-sidecars.mjs --check"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.19.1",
    "lenis": "^1.3.27",
    "lucide-react": "^0.460.0",
    "posthog-js": "1.447.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^9.0.0",
    "react-resizable-panels": "^4.20.0",
    "react-router": "^7.18.5",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "shiki": "^1.24.0",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "$katex"
  }
}
