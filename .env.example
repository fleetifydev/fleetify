# Fleetify local dev secrets. Copy to `.env` (gitignored) and fill in.
#
# Only debug builds read `.env` at runtime. In a debug build
# (`npm run dev:tauri`), `dotenvy` loads it into the backend's process env
# at the top of `serve` so the Rust side picks it up via
# `std::env::var`. Release builds never read it: a project's `.env` in the
# directory Fleetify is launched from must not configure the app. Existing
# shell env wins — set values here are a fallback.
#
# Vite reads `.env`/`.env.local` natively for the renderer: the dev server
# exposes the `VITE_*` values, and `vite build` inlines them into the bundle.

# PostHog product analytics. Both halves should match so backend + frontend
# events flow into the same PostHog project. Keys are `phc_*` public keys
# by design; safe to embed in shipped binaries. Default host is US cloud —
# set the *_HOST pair to https://eu.i.posthog.com for EU residency.
POSTHOG_API_KEY=
VITE_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Not Diamond — Fleet-owned routing key for the "Auto" model picker. Read at
# runtime by the backend (std::env::var). Fleet's own key, independent of any
# Not Diamond a user connects in Settings → Routers. Unset ⇒ Auto falls back to
# the offline built-in router. Development only: never set it in CI or in
# release builds.
NOTDIAMOND_API_KEY=

# Model catalog API — the published provider/model catalog the picker fetches at
# runtime (binary-embedded providers/agents source their lineup from here, so new
# models appear without an app release). Default is prod; point at a local mock /
# staging when testing the integration. jsDelivr is the direct-CDN fallback when
# the API is unreachable; FLEETIFY_MODELS_TAG pins its ref (tag/branch).
FLEETIFY_MODELS_API=https://fleetify.dev/api
FLEETIFY_MODELS_TAG=main
