# Fleetify local dev secrets. Copy to `.env` (gitignored) and fill in.
#
# `dotenvy` loads this into the backend's process env at the top of
# `serve_with_routing_setup` so the Rust side picks it up via
# `std::env::var`. Vite reads `.env`/`.env.local` natively for the
# renderer. Existing shell env wins — set values here are a fallback.

# PostHog product analytics. Both halves should match so backend + frontend
# events flow into the same PostHog project. Keys are `phc_*` public keys
# by design; safe to embed in shipped binaries. Default host is US cloud —
# set the *_HOST pair to https://eu.i.posthog.com for EU residency.
POSTHOG_API_KEY=
VITE_POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
